---
import { Image } from 'astro:assets';
import ArrowIcon from '../ArrowIcon.astro';
import { getDailyFeature } from '../../data/quotes';
import '../../styles/home.css';

// Starlight renders this component in place of its default hero whenever a page
// sets `hero` in its frontmatter. Only the homepage does.
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const eyebrow = 'eyebrow' in data ? (data.eyebrow as string | undefined) : undefined;
const facts = 'facts' in data ? ((data.facts as string[] | undefined) ?? []) : [];

// Fixed at build time, so the daily rebuild is what advances it. Deliberately
// not randomised on the client: that would swap the portrait after first paint.
const { scientist, quote } = getDailyFeature();

// Starlight's page-title anchor target, used by the skip link and search.
const PAGE_TITLE_ID = '_top';
---

<div class="pd-home">
	<section class="pd-hero">
		<div class="pd-hero__copy">
			{eyebrow && <p class="pd-eyebrow">{eyebrow}</p>}
			<h1 id={PAGE_TITLE_ID} data-page-title class="pd-hero__title" set:html={title} />
			{tagline && <p class="pd-hero__tagline" set:html={tagline} />}
			{
				actions.length > 0 && (
					<div class="pd-hero__actions">
						{actions.map(({ link, text, variant }) => (
							<a
								href={link}
								class:list={[
									'pd-btn',
									variant === 'primary' ? 'pd-btn--primary' : 'pd-btn--ghost',
								]}
							>
								{text}
								{variant === 'primary' && <ArrowIcon />}
							</a>
						))}
					</div>
				)
			}
			{
				facts.length > 0 && (
					<ul class="pd-hero__facts">
						{facts.map((fact) => (
							<li>{fact}</li>
						))}
					</ul>
				)
			}
		</div>

		<figure class="pd-figure pd-figure--quote">
			<Image
				class="pd-portrait"
				src={scientist.portrait}
				alt={`Portrait of ${scientist.name}.`}
				widths={[380, 500, 760]}
				sizes="(min-width: 56rem) 25rem, min(25rem, 90vw)"
				quality={78}
				style={`object-position: ${scientist.focus}`}
				loading="eager"
				fetchpriority="high"
			/>
			<figcaption>
				<blockquote class="pd-quote">“{quote.text}”</blockquote>
				<p class="pd-quote__by">
					<span class="pd-quote__name">{scientist.name}</span>
					<span class="pd-quote__lived">{scientist.lived} · {scientist.field}</span>
					<span class="pd-quote__src">
						{quote.reported ? 'As ' : ''}{quote.source}, {quote.year}
						{quote.translated ? ' (translated)' : ''}
					</span>
				</p>
				<p class="pd-quote__credit">{scientist.credit}</p>
			</figcaption>
		</figure>
	</section>
</div>
