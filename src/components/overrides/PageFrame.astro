---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				<MobileMenuToggle />
				<pd-sidebar-toggle>
					<button
						type="button"
						aria-expanded="true"
						aria-controls="starlight__sidebar"
						aria-label="Collapse sidebar"
						title="Collapse sidebar"
					>
						<span class="sidebar-panel-icon" aria-hidden="true"></span>
					</button>
				</pd-sidebar-toggle>
				<div id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</div>
			</nav>
		)
	}
	<div class="main-frame"><slot /></div>
</div>

<script>
	const storageKey = 'physicsdaily-sidebar-collapsed';

	class PhysicsDailySidebarToggle extends HTMLElement {
		button = this.querySelector('button')!;
		desktopMedia = matchMedia('(min-width: 50rem)');

		get sidebar() {
			return document.getElementById('starlight__sidebar');
		}

		connectedCallback() {
			queueMicrotask(() => this.syncSidebarAccessibility());
		}

		constructor() {
			super();
			const isCollapsed = document.documentElement.hasAttribute('data-sidebar-collapsed');
			this.setCollapsed(isCollapsed, false);
			this.desktopMedia.addEventListener('change', () => this.syncSidebarAccessibility());
			this.button.addEventListener('click', () => {
				this.setCollapsed(!document.documentElement.hasAttribute('data-sidebar-collapsed'));
			});
		}

		setCollapsed(collapsed: boolean, persist = true) {
			document.documentElement.toggleAttribute('data-sidebar-collapsed', collapsed);
			this.button.setAttribute('aria-expanded', String(!collapsed));
			this.button.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
			this.button.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
			this.syncSidebarAccessibility();
			if (persist) {
				try {
					localStorage.setItem(storageKey, String(collapsed));
				} catch {}
			}
		}

		syncSidebarAccessibility() {
			const hidden =
				this.desktopMedia.matches &&
				document.documentElement.hasAttribute('data-sidebar-collapsed');
			this.sidebar?.toggleAttribute('inert', hidden);
			if (hidden) this.sidebar?.setAttribute('aria-hidden', 'true');
			else this.sidebar?.removeAttribute('aria-hidden');
		}
	}

	if (!customElements.get('pd-sidebar-toggle')) {
		customElements.define('pd-sidebar-toggle', PhysicsDailySidebarToggle);
	}
</script>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			visibility: var(--sl-sidebar-visibility, hidden);
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		:global([aria-expanded='true']) ~ .sidebar-pane {
			--sl-sidebar-visibility: visible;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		pd-sidebar-toggle {
			display: none;
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}

			.sidebar-pane {
				--sl-sidebar-visibility: visible;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
				transition:
					transform 180ms ease,
					opacity 180ms ease;
			}

			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}

			pd-sidebar-toggle {
				display: block;
			}

			pd-sidebar-toggle button {
				position: fixed;
				z-index: calc(var(--sl-z-index-menu) + 1);
				top: calc(var(--sl-nav-height) + 1rem);
				inset-inline-start: calc(var(--sl-sidebar-width) - 2.75rem);
				display: grid;
				place-items: center;
				width: 2.25rem;
				height: 2.25rem;
				padding: 0;
				color: var(--sl-color-gray-2);
				background: var(--sl-color-bg);
				border: 0;
				border-radius: 0.35rem;
				box-shadow: none;
				cursor: pointer;
				transition:
					inset-inline-start 180ms ease,
					color 150ms ease,
					background-color 150ms ease;
			}

			pd-sidebar-toggle button:hover {
				color: var(--sl-color-white);
				background: var(--pd-surface-hover);
			}

			.sidebar-panel-icon {
				position: relative;
				display: block;
				width: 1.25rem;
				height: 1.35rem;
				border: 2px solid currentColor;
				border-radius: 0.28rem;
			}

			.sidebar-panel-icon::after {
				position: absolute;
				inset-block: 0.16rem;
				inset-inline-start: 0.28rem;
				width: 2px;
				border-radius: 999px;
				background: currentColor;
				content: '';
				transition: inset-inline-start 180ms ease;
			}

			:global([data-sidebar-collapsed]) .sidebar-pane {
				transform: translateX(-100%);
				opacity: 0;
				pointer-events: none;
			}

			:global([dir='rtl'][data-sidebar-collapsed]) .sidebar-pane {
				transform: translateX(100%);
			}

			:global([data-sidebar-collapsed]) .sidebar-panel-icon::after {
				inset-inline-start: calc(100% - 0.4rem);
			}

			/* With the sidebar gone there is no inner edge to sit on, so the toggle
			   rides along to the outer edge as the pane slides away. */
			:global([data-sidebar-collapsed]) pd-sidebar-toggle button {
				inset-inline-start: 0.75rem;
			}

			/* Shift only the content column, never `--sl-content-inline-start` itself:
			   the header grid derives its title column from that variable, so changing
			   it document-wide would reflow the title and search box on every toggle.
			   The remaining rail keeps the prose clear of the toggle button. */
			:global([data-sidebar-collapsed]) .main-frame {
				padding-inline-start: 3.5rem;
			}
		}
	}
</style>
