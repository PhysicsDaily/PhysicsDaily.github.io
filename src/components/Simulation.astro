---
interface Props {
	src: string;
	title: string;
	height?: number;
}

const { src, title, height = 620 } = Astro.props;
---

<div class="simulation-frame not-content" style={`--simulation-height: ${height}px`}>
	<iframe
		src={src}
		title={title}
		loading="lazy"
		referrerpolicy="strict-origin-when-cross-origin"
		allow="autoplay; clipboard-read; clipboard-write; fullscreen"
		allowfullscreen
	></iframe>
</div>

<style>
	.simulation-frame {
		overflow: hidden;
		width: 100%;
		height: var(--simulation-height);
		min-height: 28rem;
		margin-block: 1.5rem;
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.85rem;
		box-shadow: 0 14px 35px rgb(0 0 0 / 10%);
	}

	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (max-width: 40rem) {
		.simulation-frame {
			height: min(var(--simulation-height), 34rem);
		}
	}
</style>
