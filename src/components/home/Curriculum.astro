---
import { base, getChapters } from '../../data/chapters';
import '../../styles/home.css';

const mechanicsChapters = getChapters(Astro.locals.starlightRoute.sidebar, 'mechanics');

// Branch order follows Halliday, Resnick & Krane: mechanics, oscillations
// and waves, thermodynamics, electrodynamics, optics, then modern physics.
const branches = [
	{
		name: 'Mechanics',
		slug: 'mechanics/',
		count: mechanicsChapters.length,
	},
	{
		name: 'Oscillations & Waves',
		slug: null,
		count: 0,
	},
	{
		name: 'Thermodynamics',
		slug: null,
		count: 0,
	},
	{
		name: 'Electrodynamics',
		slug: null,
		count: 0,
	},
	{
		name: 'Optics',
		slug: null,
		count: 0,
	},
	{
		name: 'Modern Physics',
		slug: null,
		count: 0,
	},
];
---

<section class="pd-section not-content" id="curriculum">
	<header class="pd-section__head">
		<p class="pd-eyebrow">Curriculum</p>
		<h2 class="pd-title">The six branches of physics</h2>
		<p class="pd-lede">
			Each branch is divided into chapters meant to be read in order, since later chapters build on
			earlier ones. Mechanics is available now; the remaining branches are in progress.
		</p>
	</header>

	<ol class="pd-track">
		{
			branches.map((branch, index) => {
				const number = String(index + 1).padStart(2, '0');
				const body = (
					<>
						<span class="pd-branch__num">{number}</span>
						<div class="pd-branch__body">
							<h3 class="pd-branch__name">{branch.name}</h3>
						</div>
						<span class="pd-branch__meta">
							{branch.slug ? (
								<>
									<span class="pd-branch__dot" />
									{branch.count} {branch.count === 1 ? 'chapter' : 'chapters'}
									<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
										<path
											d="M2.5 8h11m-4-4 4 4-4 4"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</>
							) : (
								'Planned'
							)}
						</span>
					</>
				);

				return (
					<li>
						{branch.slug ? (
							<a class="pd-branch" href={`${base}${branch.slug}`}>
								{body}
							</a>
						) : (
							<div class="pd-branch pd-branch--planned">{body}</div>
						)}
					</li>
				);
			})
		}
	</ol>
</section>
