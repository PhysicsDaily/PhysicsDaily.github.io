---
interface Props {
	/** Width and height in pixels. Defaults to 16. */
	size?: number;
}

const { size = 16 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 16 16"
	aria-hidden="true"
	fill="none"
>
	<path
		d="M2.5 8h11m-4-4 4 4-4 4"
		stroke="currentColor"
		stroke-width="1.6"
		stroke-linecap="round"
		stroke-linejoin="round"
	/>
</svg>
